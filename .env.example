# Servidor
# Deixe PORT vazia para usar a porta fornecida pela hospedagem (ou uma porta dinâmica local).
PORT=
# HOST é opcional. Deixe vazia para o Node.js usar o endereço padrão do ambiente.
HOST=
LOG_LEVEL=info

# MongoDB Atlas — usa o mesmo banco da King's Newsletter
# Configure a URI privada do cluster; o worker seleciona o banco kings_newsletter.
MONGODB_URI=

# Agendador
SCHEDULER_ENABLED=true
CHECK_INTERVAL_MS=10800000
TIME_ZONE=America/Rio_Branco

# Banco SQLite local persistido em data/worker.db (no Shardcloud, sob /app)
WORKER_DB_PATH=./data/worker.db
WORKER_HISTORY_RETENTION_DAYS=90

# API: preencher apenas com base em documentação confirmada
NEWSLETTER_API_BASE_URL=
NEWSLETTER_API_PATH=/api/notify-news
NEWSLETTER_API_METHOD=POST
NEWSLETTER_API_TOKEN=
NEWSLETTER_API_TIMEOUT_MS=10000
NEWSLETTER_API_MAX_RETRIES=3
NEWSLETTER_API_RETRY_BASE_MS=500

# Controle seguro do agendamento pelo painel (use o mesmo segredo no site)
WORKER_CONTROL_SECRET=
WORKER_CONTROL_TIMEOUT_MS=10000
WORKER_CONTROL_POLL_MS=30000

# Monitor web (ambas as variáveis são obrigatórias para habilitar /monitor)
MONITOR_USERNAME=
MONITOR_PASSWORD=

# ------------------------------------------------- Coleta do King's Sports
# Liga a coleta de dados do Sports (placar ao vivo, jogos, tabelas, escudos e
# temporada). Usa o mesmo MONGODB_URI acima e grava só na coleção do Sports.
SPORTS_INGEST_ENABLED=false
SPORTS_MONGODB_DB=kings_newsletter
SPORTS_MONGODB_COLLECTION=sports
# Intervalo do placar ao vivo, em segundos (mínimo 5)
SPORTS_LIVE_EVERY_SEC=15

# ESPN (fonte principal, sem chave): teto diário e intervalo mínimo do ao vivo
ESPN_DAILY_BUDGET=3000
ESPN_LIVE_MIN_INTERVAL_SEC=15

# SportAPI (reserva de futebol e NBA), chave grátis em https://sportapi.ai
SPORTAPI_KEY=
# Limites de segurança (plano grátis: 1.000/dia e 7.000/mês)
SPORTAPI_DAILY_BUDGET=220
SPORTAPI_MONTHLY_BUDGET=6800
# Intervalo mínimo, em minutos, entre coletas ao vivo da SportAPI
LIVE_MIN_INTERVAL_MIN=10

# TheSportsDB (escudos). Vazio usa a chave pública.
THESPORTSDB_KEY=
