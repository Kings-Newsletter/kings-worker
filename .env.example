# Servidor
# Deixe PORT vazia para usar a porta fornecida pela hospedagem (ou uma porta dinâmica local).
PORT=
# HOST é opcional. Deixe vazia para o Node.js usar o endereço padrão do ambiente.
HOST=
LOG_LEVEL=info

# Agendador
SCHEDULER_ENABLED=true
CHECK_INTERVAL_MS=10800000
TIME_ZONE=America/Rio_Branco

# Banco SQLite local persistido em data/worker.db (no Shardcloud, sob /app)
WORKER_DB_PATH=./data/worker.db
WORKER_HISTORY_RETENTION_DAYS=90

# API: preencher apenas com base em documentação confirmada
NEWSLETTER_API_BASE_URL=
NEWSLETTER_API_PATH=/api/notify-news
NEWSLETTER_API_METHOD=POST
NEWSLETTER_API_TOKEN=
NEWSLETTER_API_TIMEOUT_MS=10000
NEWSLETTER_API_MAX_RETRIES=3
NEWSLETTER_API_RETRY_BASE_MS=500

# Controle seguro do agendamento pelo painel (use o mesmo segredo no site)
WORKER_CONTROL_SECRET=
WORKER_CONTROL_TIMEOUT_MS=10000
WORKER_CONTROL_POLL_MS=30000

# Monitor web (ambas as variáveis são obrigatórias para habilitar /monitor)
MONITOR_USERNAME=
MONITOR_PASSWORD=
